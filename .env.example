# Copy this file to .env and fill in real values. Never commit .env.
# Special characters in the password must be URL-encoded (for example # becomes %23).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# development | test | staging | production
# Local administration (PDF ingestion, review, publications, contract uploads)
# is mounted only in development and only answers loopback requests.
ENVIRONMENT=development
LEGALMIND_DEBUG=false
LOG_LEVEL=INFO
# text | json (one JSON object per line, for log aggregation)
# LOG_FORMAT=text
# Comma separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------ Public API safety
# Shared secrets for /ask and /search/legal, comma separated. Clients send one as
# "X-API-Key: <key>" or "Authorization: Bearer <key>". Empty leaves them open.
# API_KEYS=
# Requests per client per minute for /ask and /search/legal (0 disables).
# RATE_LIMIT_PER_MINUTE=60
# Interactive docs (/docs) are off in production unless enabled explicitly.
# DOCS_ENABLED=false

# ------------------------------------------------------------------ Retrieval
# /search/legal and /ask need an activated publication (see README).
LEGAL_SEARCH_ENABLED=false
# The active publication is held in memory and re-checked on this interval.
# PUBLICATION_REFRESH_SECONDS=60
# Local cache of the publication snapshot, so restarts skip the database
# transfer. Leave empty to disable.
# PUBLICATION_CACHE_DIR=.cache/publications
# LEGAL_SEARCH_CANDIDATE_POOL=50
# Noise floor for vector candidates; relevance is decided downstream.
# LEGAL_SEARCH_MIN_SIMILARITY=0.30
# LEGAL_SEARCH_RRF_K=60
# LEGAL_SEARCH_TIMEOUT_SECONDS=30
# Seconds to wait for query embedding before returning keyword matches.
# LEGAL_SEARCH_EMBEDDING_TIMEOUT_SECONDS=3
# Load the embedding and reranker models at start-up instead of on first use.
# MODELS_WARM_ON_STARTUP=true

# --------------------------------------------------------- Question answering
# Put the real key only in the ignored backend .env; never commit or paste it.
# LLM_PROVIDER: auto (Gemini if GEMINI_API_KEY is set, else OpenAI) | gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Asked when the primary model is overloaded, rate limited or slow; empty disables it.
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Total seconds for one model exchange, including retries and racing calls.
# QA_GEMINI_TIMEOUT_SECONDS=25
# While a call has not answered after this long, another call is started
# beside it and the first reply wins (0 disables).
# QA_LLM_HEDGE_SECONDS=3.0
# Failed calls (timeout, 429/5xx, malformed output) replaced before giving up.
# QA_LLM_MAX_RETRIES=5
# QA_LLM_TEMPERATURE=0.2
# QA_GEMINI_MAX_OUTPUT_TOKENS=1500
# Optional for models that support thinking levels: minimal | low | medium | high
# QA_GEMINI_THINKING_LEVEL=
# OPENAI_API_KEY and OPENAI_MODEL are used with LLM_PROVIDER=openai, and as a
# failover when Gemini is configured but unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# QA_REQUEST_TIMEOUT_SECONDS=60
# QA_MAX_CONCURRENT_REQUESTS=8
# QA_QUEUE_TIMEOUT_SECONDS=10
# Earlier conversation turns the server uses for follow-up questions.
# QA_HISTORY_MAX_TURNS=6
# Restate a question the search could not match well (Roman Urdu, heavy slang).
# QA_REWRITE_ENABLED=true
# Longest the restatement may take; it is optional, so a slow model must not delay the answer.
# QA_REWRITE_TIMEOUT_SECONDS=6

# Cross-encoder reranking: auto | on | off. "auto" measures this host at
# start-up and reranks only when it fits QA_RERANK_BUDGET_MS; a large reranker
# on a CPU-only machine is otherwise slower than the rest of the request.
# QA_RERANK_MODE=auto
# QA_RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
# QA_RERANK_BUDGET_MS=1500
# QA_RERANK_DEVICE=cpu
# Provisions passed to the answer model, and the size of the evidence packet.
# QA_RERANK_TOP_K=6
# QA_CONTEXT_MAX_CHARS=24000
# Related provisions of the same law added to the evidence: those the best
# passages refer to, and those that cite them by number (penalty clauses).
# QA_CONTEXT_MAX_REFERENCE_SECTIONS=2
# QA_CONTEXT_MAX_REFERRING_SECTIONS=2

# Store question/answer audit rows. Needs migrations 20261017_18 and 20261111_19
# and a reviewed retention policy.
QA_RECORD_RUNS=false

# ------------------------------------------------------ Contract uploads
# POST /contracts. Local disk, development only.
# UPLOAD_DIR=uploads/contracts
# UPLOAD_MAX_SIZE_BYTES=10485760
# UPLOAD_MAX_PAGES=10

# -------------------------------------------- Local legal-corpus administration
# Keep false on hosted servers. Run uvicorn bound to 127.0.0.1 when enabling.
LEGAL_INGEST_ENABLED=false
# LEGAL_UPLOAD_DIR=uploads/legal
# LEGAL_UPLOAD_MAX_SIZE_BYTES=104857600
# LEGAL_UPLOAD_MAX_PAGES=2000
# LEGAL_OCR_TESSDATA_DIR=uploads/ocr/tessdata
# LEGAL_OCR_LANGUAGES=eng
# LEGAL_OCR_DPI=200
# Seconds a worker may hold a job before another worker may reclaim it.
# LEGAL_WORKER_LEASE_SECONDS=900

# ------------------------------------------------------------------ Database
# DB_SSL=true encrypts the connection. Set DB_SSL_ROOT_CERT to the provider's CA
# certificate file to also verify the server (recommended in production).
# DB_SSL=true
# DB_SSL_ROOT_CERT=
# Optional pool tuning (defaults are fine)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_CONNECT_RETRIES=3
# Seconds allowed for TLS + login. Raise it if the database is far away.
# DB_CONNECT_TIMEOUT=20
# DB_COMMAND_TIMEOUT=120
