# Copy this file to .env and fill in real values.
# Special characters in the password must be URL-encoded (for example # becomes %23).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

ENVIRONMENT=development
LEGALMIND_DEBUG=false
LOG_LEVEL=INFO
# Comma separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Stage 10 returns evidence candidates; it does not generate legal answers.
# Requires a validated, activated Stage 9 publication and pgvector >=0.8.
LEGAL_SEARCH_ENABLED=false
# LEGAL_SEARCH_CANDIDATE_POOL=50
# LEGAL_SEARCH_MIN_SIMILARITY=0.48
# LEGAL_SEARCH_RRF_K=60
# LEGAL_SEARCH_HNSW_EF_SEARCH=200
# LEGAL_SEARCH_TIMEOUT_SECONDS=90

# ----------------------------------------------------- Phase C question answering
# Set LEGAL_SEARCH_ENABLED=true after activating an approved publication.
# Put the real key only in the ignored backend .env; never commit or paste it.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# QA_GEMINI_TIMEOUT_SECONDS=90
# QA_GEMINI_MAX_OUTPUT_TOKENS=1200
# Optional for models that support thinking levels: QA_GEMINI_THINKING_LEVEL=minimal
# QA_REQUEST_TIMEOUT_SECONDS=180
# QA_CONTEXT_MAX_UNITS=12
# OPENAI_API_KEY and OPENAI_MODEL are used with LLM_PROVIDER=openai.
# If LLM_PROVIDER is unset or auto, a Gemini key takes precedence.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# QA_OPENAI_TIMEOUT_SECONDS=35
# QA_OPENAI_MAX_OUTPUT_TOKENS=1200
# QA_REPAIR_ATTEMPTS=1
# Keep false until optional QA migrations 20261017_18 and 20261111_19 are applied.
QA_RECORD_RUNS=false

# ------------------------------------------------------ Contract uploads
# POST /contracts. Local disk for now (local/team-only demo).
# UPLOAD_DIR=uploads/contracts
# UPLOAD_MAX_SIZE_BYTES=10485760
# UPLOAD_MAX_PAGES=10

# -------------------------------------------- Local legal-corpus upload only
# Keep false on hosted servers. Run uvicorn bound to 127.0.0.1 when enabling.
LEGAL_INGEST_ENABLED=false
# LEGAL_UPLOAD_DIR=uploads/legal
# LEGAL_UPLOAD_MAX_SIZE_BYTES=104857600
# LEGAL_UPLOAD_MAX_PAGES=2000
# LEGAL_OCR_TESSDATA_DIR=uploads/ocr/tessdata
# LEGAL_OCR_LANGUAGES=eng
# LEGAL_OCR_DPI=200

# Optional database pool tuning (defaults are fine)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_CONNECT_RETRIES=3
# Seconds allowed for TLS + login. Raise it if the database is far away.
# DB_CONNECT_TIMEOUT=20
# DB_COMMAND_TIMEOUT=120
