# Copy this file to .env and fill in real values.
# Special characters in the password must be URL-encoded (for example # becomes %23).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

ENVIRONMENT=development
LEGALMIND_DEBUG=false
LOG_LEVEL=INFO
# Comma separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------- OpenAI
# Key from https://platform.openai.com/api-keys (the API needs billing credit;
# a ChatGPT subscription does not include it).
OPENAI_API_KEY=
# Any chat model your account can use, e.g. gpt-4o-mini, gpt-4.1-mini, gpt-4o
OPENAI_MODEL=gpt-4o-mini
# Test your key and model with:  python scripts/check_llm.py
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_TEMPERATURE=0.1
# LLM_MAX_OUTPUT_TOKENS=2048
# LLM_TIMEOUT=30

# ------------------------------------------------------------ Embeddings
# Must match the vector(N) column width; the migration reads EMBEDDING_DIM.
# Changing the model means: clear embeddings, re-run alembic, re-embed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# EMBEDDING_DEVICE=cpu
# Set to false to run keyword-only retrieval (no model download needed)
# EMBEDDINGS_ENABLED=true

# ------------------------------------------------------------- Retrieval
# Text is only quoted to a user if its source is in one of these states.
# Set to "approved" before any real user sees an answer.
RETRIEVAL_REVIEW_STATUSES=needs_review,approved
# RETRIEVAL_TOP_K=5
# Evidence gate: below BOTH thresholds /ask refuses without calling the LLM.
# Tune these once real embeddings are in place (see README).
# RETRIEVAL_MIN_KEYWORD_RANK=0.02
# RETRIEVAL_MIN_VECTOR_SIMILARITY=0.30

# ------------------------------------------------------ Contract uploads
# POST /contracts. Local disk for now (local/team-only demo).
# UPLOAD_DIR=uploads/contracts
# UPLOAD_MAX_SIZE_BYTES=10485760
# UPLOAD_MAX_PAGES=10

# Optional database pool tuning (defaults are fine)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_CONNECT_RETRIES=3
# Seconds allowed for TLS + login. Raise it if the database is far away.
# DB_CONNECT_TIMEOUT=20
